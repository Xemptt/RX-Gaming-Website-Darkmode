# Website origin, separate from Minecraft connection addresses.
SITE_URL=https://your-website.example
# Public Headless API token from your Tebex creator dashboard.
TEBEX_PUBLIC_TOKEN=
# Server-only Headless API private key from the same Tebex API Keys page.
# Required to authenticate backend checkout requests with the customer IP.
TEBEX_PRIVATE_KEY=

# Non-Vercel hosts: name the header YOUR trusted reverse proxy overwrites with
# one actual customer IPv4/IPv6 address. Block direct access to the app origin.
TEBEX_CLIENT_IP_HEADER=
