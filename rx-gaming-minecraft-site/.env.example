# Template only: leave credentials blank in this tracked file.
# Production values go in Vercel > Settings > Environment Variables.
# For local development, copy this file to the ignored .env.local file.
# Website origin, separate from Minecraft connection addresses.
SITE_URL=https://your-website.example
# Public Headless API token from your Tebex creator dashboard.
TEBEX_PUBLIC_TOKEN=14u64-50d09e99f4c12cc721bec5d4a13b27637f43aee3
# Server-only Headless API private key from the same Tebex API Keys page.
# Required to authenticate backend checkout requests with the customer IP.
TEBEX_PRIVATE_KEY=WewOu4oMm55iwEDK913EvjeJFmqg3UD3

# Discord Developer Portal > application > OAuth2. Server-only credentials.
# Register SITE_URL + /api/discord/callback as an OAuth2 redirect URL.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Non-Vercel hosts: name the header YOUR trusted reverse proxy overwrites with
# one actual customer IPv4/IPv6 address. Block direct access to the app origin.
TEBEX_CLIENT_IP_HEADER=
