# Website origin, separate from Minecraft connection addresses.
SITE_URL=https://your-website.example
# Public Headless API token from your Tebex creator dashboard.
TEBEX_PUBLIC_TOKEN=


# Non-Vercel production hosts only: the reverse proxy MUST overwrite this header
# and block direct access to the app. Leave unset for local development.
TEBEX_CLIENT_IP_HEADER=
